let currentCategory = 'entradas';

let currentTagFilter = 'all';

let currentModalDish = null;



// Renderizar cards na tela

function renderDishes() {

const grid = document.getElementById('dishesGrid');

grid.innerHTML = '';



let list = dishesData[currentCategory] || [];



// Aplicar filtro de tags

if (currentTagFilter !== 'all') {

list = list.filter(d => d.tags.includes(currentTagFilter));

}



// Aplicar filtro da barra de busca

const searchVal = document.getElementById('searchInput').value.toLowerCase();

if (searchVal.trim() !== '') {

list = list.filter(d =>

d.nomeClaro.toLowerCase().includes(searchVal) ||

d.nomeOriginal.toLowerCase().includes(searchVal) ||

d.desc.toLowerCase().includes(searchVal)

);

}



if (list.length === 0) {

grid.innerHTML = `<div style="grid-column: 1/-1; text-align: center; padding: 40px; color: var(--text-muted);">

<i class="fa-solid fa-utensils" style="font-size: 3rem; margin-bottom: 12px; opacity: 0.3;"></i>

<p>Nenhum prato encontrado com os filtros selecionados.</p>

</div>`;

return;

}



list.forEach(dish => {

const card = document.createElement('div');

card.className = 'card-dish';



const allergensHtml = dish.alergens.map(a =>

`<span class="allergen-tag ${a.type}">${a.text}</span>`

).join('');



card.innerHTML = `

<div class="dish-img-wrapper">

<img src="${dish.imagem}" alt="${dish.nomeClaro}" loading="lazy">

<div class="portion-badge">

<i class="fa-solid fa-users"></i> ${dish.porcao}

</div>

</div>

<div class="dish-content">

<div>

<div class="dish-header">

<div>

<h3 class="dish-title">${dish.nomeClaro}</h3>

<div style="font-size: 0.75rem; color: #94a3b8; font-style: italic; margin-top: 2px;">

Anteriormente: "${dish.nomeOriginal}"

</div>

</div>

<span class="dish-price">R$ ${dish.preco.toFixed(2).replace('.', ',')}</span>

</div>

<p class="dish-description">${dish.desc}</p>

</div>


<div>

<div class="allergens-list">

${allergensHtml}

</div>

<div class="card-footer">

<button class="btn-detail" onclick='openModal(${JSON.stringify(dish)})'>

<i class="fa-solid fa-circle-info"></i> Detalhes

</button>

<button class="btn-order" onclick="addToCart('${dish.nomeClaro}', ${dish.preco})">

<i class="fa-solid fa-plus"></i> Pedir

</button>

</div>

</div>

</div>

`;

grid.appendChild(card);

});

}



// Trocar Categoria

function switchCategory(catKey, btn) {

currentCategory = catKey;

document.querySelectorAll('.nav-item').forEach(b => b.classList.remove('active'));

btn.classList.add('active');



const titles = {

entradas: { name: 'Entradas e Petiscos', icon: 'fa-bread-slice' },

carnes: { name: 'Carnes Nobres & Assados', icon: 'fa-drumstick-bite' },

peixes: { name: 'Peixes & Frutos do Mar', icon: 'fa-fish' },

massas: { name: 'Massas Artesanais & Fit', icon: 'fa-bowl-rice' },

sobremesas: { name: 'Sobremesas & Bebidas', icon: 'fa-ice-cream' }

};



document.getElementById('categoryTitle').innerHTML =

`<i class="fa-solid ${titles[catKey].icon}" style="color: var(--primary);"></i> ${titles[catKey].name}`;



renderDishes();

}



// Filtros de Tag

function filterTag(tag, btn) {

currentTagFilter = tag;

document.querySelectorAll('.filter-chip').forEach(b => b.classList.remove('active'));

btn.classList.add('active');

renderDishes();

}



// Busca rápida

function filterDishes() {

renderDishes();

}



// Acessibilidade Senior (Persona Maria das Graças)

function toggleSeniorMode() {

document.body.classList.toggle('senior-mode');

const btn = document.getElementById('seniorBtn');

btn.classList.toggle('active');

}



// Modal de Detalhes

function openModal(dish) {

currentModalDish = dish;

document.getElementById('modalImg').src = dish.imagem;

document.getElementById('modalTitle').innerText = dish.nomeClaro;

document.getElementById('modalPrice').innerText = `R$ ${dish.preco.toFixed(2).replace('.', ',')}`;

document.getElementById('modalPortion').innerText = `Rendimento: ${dish.porcao}`;

document.getElementById('modalDesc').innerText = dish.desc;

document.getElementById('modalIngredients').innerText = dish.ingredientes;



const allergensBox = document.getElementById('modalAllergens');

allergensBox.innerHTML = dish.alergens.map(a =>

`<span class="allergen-tag ${a.type}" style="font-size:0.85rem; padding:6px 12px;">${a.text}</span>`

).join('');



document.getElementById('dishModal').style.display = 'flex';

}



function closeModal() {

document.getElementById('dishModal').style.display = 'none';

}



// Adicionar ao carrinho

let cartCount = 2;

let cartTotal = 186.00;



function addToCart(nome, preco) {

cartCount++;

cartTotal += preco;

document.getElementById('cartCount').innerText = cartCount;

document.getElementById('cartTotal').innerText = `R$ ${cartTotal.toFixed(2).replace('.', ',')}`;


// Animação visual no carrinho flutuante

const cart = document.querySelector('.floating-cart');

cart.style.transform = 'scale(1.1)';

setTimeout(() => cart.style.transform = 'scale(1)', 200);

}



function addToCartModal() {

if(currentModalDish) {

addToCart(currentModalDish.nomeClaro, currentModalDish.preco);

closeModal();

}

}



// Inicialização

renderDishes();

</script>

